# cavinum.me — боевой .htaccess.
#
# Nginx перед Apache уже сделал HTTP->HTTPS и проксирует X-Forwarded-Proto,
# но правило нормализации слеша ниже специально не полагается на то, что
# Apache знает о схеме: Location строится с явным https://cavinum.me/ во
# всех случаях.
#
# Языковая логика (боты/cookie/Accept-Language/префикс /en) отсюда убрана:
# Accept-Language до mod_rewrite в этой связке nginx->Apache не доходит
# (подтверждено диагностикой — Cookie доезжает, Accept-Language нет), и
# копаться в транспорте дальше не стали. Выбор языка теперь на клиенте —
# блокирующий скрипт в Base.astro.

<IfModule mod_dir.c>
	# Свой редирект на слеш (правило ниже) полностью заменяет DirectorySlash.
	# Родной DirectorySlash не знает про X-Forwarded-Proto и отдавал
	# Location: http://... — подтверждено админом как штатное поведение,
	# а не баг конфигурации, поэтому выключаем его целиком, а не полагаемся
	# на то, что mod_rewrite успевает сработать раньше него. Два механизма,
	# делающих одно и то же по-разному, — источник ровно этого расхождения.
	DirectorySlash Off
</IfModule>

# Без DirectorySlash при промахе (путь-директория, не покрытый правилом
# ниже) Apache либо отдаст index-файл под неверным URL, либо, если совпадения
# по индексу нет — листинг каталога. Правило ниже покрывает все директории
# параметрически (проверка -d, а не список путей), но это защита на случай
# нештатной ситуации, а не расчёт на неё.
Options -Indexes

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Нужен ли завершающий слеш? Тот же тест, что делал бы DirectorySlash
	# (реальная директория без слеша на конце), но без него самого — см.
	# блок mod_dir выше.
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteCond %{REQUEST_URI} !/$
	RewriteRule ^(.*)$ https://cavinum.me/$1/ [R=301,L]
</IfModule>

# Срабатывает только когда Apache не нашёл ресурс — правило слеша выше не
# матчит несуществующий путь (завязано на -d реальной директории), так что
# конфликта с редиректом нет. Это внутренний сабреквест, не редирект: клиент
# не видит смену URL, статус ответа — 404, не 200 (иначе Google засчитает
# как soft 404).
# Английская подветка переопределяется в public/en/.htaccess — Apache мёржит
# .htaccess по всем реальным каталогам на пути, включая /en/, даже если
# конечный путь запроса не существует.
ErrorDocument 404 /404.html

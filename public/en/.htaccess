# Переопределяет ErrorDocument из корневого .htaccess для всего, что физически
# лежит под /en/ — Apache мёржит .htaccess всех реальных каталогов на пути
# запроса, поэтому даже несуществующий /en/что-то-левое подхватывает этот
# файл. src/pages/en/404.astro — обычная страница (не спец. /404.html, как
# в корне), поэтому целимся прямо в её index.html.
ErrorDocument 404 /en/404/index.html

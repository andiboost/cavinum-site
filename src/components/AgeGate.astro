---
import { ui, defaultLang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang].ageGate;
---

<div class="age-gate" id="age-gate" hidden>
	<div class="age-gate__backdrop" aria-hidden="true"></div>
	<div class="age-gate__panel" role="dialog" aria-modal="true" aria-labelledby="age-gate-message">
		<p id="age-gate-message" class="age-gate__text" data-age-gate-message tabindex="-1">
			{t.question}
		</p>
		<div class="age-gate__actions" data-age-gate-actions>
			<button type="button" class="age-gate__button age-gate__button--yes" data-age-gate-yes
				>{t.yes}</button
			>
			<button type="button" class="age-gate__button age-gate__button--no" data-age-gate-no
				>{t.no}</button
			>
		</div>
		<div class="age-gate__leave" data-age-gate-leave hidden>
			<button
				type="button"
				class="age-gate__button age-gate__button--leave"
				data-age-gate-leave-btn
				>{t.leave}</button
			>
		</div>
		<p class="age-gate__warning" data-age-gate-warning>{t.warning}</p>
	</div>
</div>

<script define:vars={{ t }}>
	(function () {
		const STORAGE_KEY = 'cavinum-age-ok';
		let confirmed = false;
		try {
			confirmed = localStorage.getItem(STORAGE_KEY) === '1';
		} catch (e) {}
		if (confirmed) return;

		const gate = document.getElementById('age-gate');
		const message = gate.querySelector('[data-age-gate-message]');
		const actions = gate.querySelector('[data-age-gate-actions]');
		const leave = gate.querySelector('[data-age-gate-leave]');
		const yesBtn = gate.querySelector('[data-age-gate-yes]');
		const noBtn = gate.querySelector('[data-age-gate-no]');
		const leaveBtn = gate.querySelector('[data-age-gate-leave-btn]');
		const siblings = Array.from(document.body.children).filter((el) => el !== gate);

		function trapFocus(e) {
			if (e.key !== 'Tab') return;
			const list = Array.from(gate.querySelectorAll('button')).filter(
				(el) => !el.disabled && el.offsetParent !== null
			);
			if (list.length === 0) return;
			const first = list[0];
			const last = list[list.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		}

		gate.hidden = false;
		siblings.forEach((el) => {
			el.inert = true;
		});
		document.addEventListener('keydown', trapFocus);
		yesBtn.focus();

		yesBtn.addEventListener('click', () => {
			try {
				localStorage.setItem(STORAGE_KEY, '1');
			} catch (e) {}
			gate.hidden = true;
			document.removeEventListener('keydown', trapFocus);
			siblings.forEach((el) => {
				el.inert = false;
			});
		});

		noBtn.addEventListener('click', () => {
			message.textContent = t.blocked;
			actions.hidden = true;
			leave.hidden = false;
			message.focus();
		});

		leaveBtn.addEventListener('click', () => {
			location.replace('https://www.google.com');
		});
	})();
</script>

<style>
	.age-gate[hidden] {
		display: none;
	}

	.age-gate {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(1rem, 5vw, 2rem);
	}

	.age-gate__backdrop {
		position: absolute;
		inset: 0;
		background: var(--paper);
	}

	.age-gate__panel {
		position: relative;
		width: 100%;
		max-width: 24rem;
		text-align: center;
		background: var(--surface);
		border-radius: 1rem;
		padding: clamp(1.75rem, 5vw, 2.5rem);
		box-shadow: 0 1.5rem 4rem color-mix(in srgb, var(--ink) 25%, transparent);
	}

	.age-gate__text {
		margin: 0 0 var(--space-3);
		font-size: clamp(1.05rem, 2.5vw, 1.3rem);
		font-weight: 600;
	}

	.age-gate__text:focus-visible {
		outline: none;
	}

	.age-gate__actions,
	.age-gate__leave {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.age-gate__actions[hidden],
	.age-gate__leave[hidden] {
		display: none;
	}

	.age-gate__button {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		min-height: 44px;
		min-width: 44px;
		padding: 0.75rem 1.5rem;
		border: 0;
		border-radius: 999px;
		font-weight: 600;
		font-size: 1rem;
		line-height: 1.3;
		text-align: center;
		white-space: normal;
		cursor: pointer;
	}

	.age-gate__button--yes,
	.age-gate__button--leave {
		background: var(--accent);
		color: var(--paper);
	}

	.age-gate__button--no {
		background: none;
		box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--ink) 30%, transparent);
		color: var(--ink);
	}

	.age-gate__button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	.age-gate__warning {
		margin: var(--space-3) 0 0;
		padding: 1.1rem 1.25rem;
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--ink) 8%, transparent);
		font-size: 0.95rem;
		line-height: 1.55;
		font-weight: 500;
		color: var(--ink);
	}
</style>

---
import IconLayoutGrid from './icons/IconLayoutGrid.astro';
import IconGlobe from './icons/IconGlobe.astro';
import IconSearch from './icons/IconSearch.astro';
import IconGlassWater from './icons/IconGlassWater.astro';
import IconGlassesPair from './icons/IconGlassesPair.astro';
import IconLeaf from './icons/IconLeaf.astro';
import IconGrape from './icons/IconGrape.astro';
import IconCompass from './icons/IconCompass.astro';
import IconPuzzle from './icons/IconPuzzle.astro';

const icons = {
	shelf: IconLayoutGrid,
	globe: IconGlobe,
	search: IconSearch,
	glass: IconGlassWater,
	glasses: IconGlassesPair,
	leaf: IconLeaf,
	grape: IconGrape,
	compass: IconCompass,
	puzzle: IconPuzzle,
} as const;

interface Props {
	icon: keyof typeof icons;
	text: string;
	variant?: 'tile' | 'row';
}
const { icon, text, variant = 'tile' } = Astro.props;
const Icon = icons[icon];
---

<div class:list={['card', `card--${variant}`]}>
	<span class="card__icon" aria-hidden="true"><Icon /></span>
	<p class="card__text">{text}</p>
</div>

<style>
	.card {
		display: flex;
		align-items: flex-start;
		gap: clamp(0.75rem, 2vw, 1.25rem);
	}
	.card--tile {
		flex-direction: column;
		align-items: flex-start;
		background: var(--surface);
		border-radius: clamp(0.75rem, 1.5vw, 1.25rem);
		padding: clamp(1.1rem, 2.5vw, 1.6rem);
		min-height: 44px;
	}
	.card--row {
		flex-direction: row;
		align-items: center;
	}
	.card__icon {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: clamp(2.75rem, 6vw, 3.75rem);
		height: clamp(2.75rem, 6vw, 3.75rem);
		border-radius: 50%;
		background: var(--accent);
		color: var(--paper);
		font-size: clamp(1.3rem, 3vw, 1.8rem);
	}
	.card__icon :global(svg) {
		stroke-width: 2.25;
	}
	.card--tile .card__icon {
		margin-block-end: 0.25rem;
	}
	.card__text {
		margin: 0;
		font-size: clamp(0.95rem, 1.6vw, 1.1rem);
		line-height: 1.5;
	}
</style>

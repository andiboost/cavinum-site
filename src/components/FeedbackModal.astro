---
import { ui, defaultLang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang].feedback;
---

<div class="feedback-modal" id="feedback-modal" hidden>
	<div class="feedback-modal__backdrop" data-feedback-close></div>
	<div
		class="feedback-modal__panel"
		role="dialog"
		aria-modal="true"
		aria-labelledby="feedback-modal-title"
	>
		<button
			type="button"
			class="feedback-modal__close"
			data-feedback-close
			aria-label={t.close}
		>
			&times;
		</button>
		<h2 id="feedback-modal-title" class="feedback-modal__title">{t.title}</h2>
		<form class="feedback-modal__form" id="feedback-form" novalidate>
			<label class="feedback-modal__field">
				<span>{t.name}</span>
				<input type="text" name="name" required maxlength="200" autocomplete="name" />
			</label>
			<label class="feedback-modal__field">
				<span>{t.subject}</span>
				<input type="text" name="subject" required maxlength="200" />
			</label>
			<label class="feedback-modal__field">
				<span>{t.message}</span>
				<textarea name="message" required maxlength="5000" rows="5"></textarea>
			</label>
			<label class="feedback-modal__honeypot" aria-hidden="true" tabindex="-1">
				Website
				<input type="text" name="website" tabindex="-1" autocomplete="off" />
			</label>
			<button type="submit" class="feedback-modal__submit">{t.submit}</button>
			<p class="feedback-modal__status" role="status" aria-live="polite"></p>
		</form>
	</div>
</div>

<script define:vars={{ t }}>
	const modal = document.getElementById('feedback-modal');
	const form = document.getElementById('feedback-form');
	const status = form.querySelector('.feedback-modal__status');
	const submitBtn = form.querySelector('.feedback-modal__submit');
	let lastFocused = null;

	function focusableElements() {
		return Array.from(
			modal.querySelectorAll(
				'button, [href], input, textarea, select, [tabindex]:not([tabindex="-1"])'
			)
		).filter((el) => !el.disabled && el.offsetParent !== null);
	}

	function openModal() {
		lastFocused = document.activeElement;
		modal.hidden = false;
		const firstField = form.querySelector('input[name="name"]');
		firstField?.focus();
		document.addEventListener('keydown', onKeydown);
	}

	function closeModal() {
		modal.hidden = true;
		document.removeEventListener('keydown', onKeydown);
		status.textContent = '';
		status.classList.remove('is-error', 'is-success');
		form.reset();
		submitBtn.disabled = false;
		submitBtn.textContent = t.submit;
		lastFocused?.focus();
	}

	function onKeydown(e) {
		if (e.key === 'Escape') {
			closeModal();
			return;
		}
		if (e.key === 'Tab') {
			const list = focusableElements();
			if (list.length === 0) return;
			const first = list[0];
			const last = list[list.length - 1];
			if (e.shiftKey && document.activeElement === first) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		}
	}

	document.querySelectorAll('[data-open-feedback]').forEach((el) => {
		el.addEventListener('click', (e) => {
			e.preventDefault();
			openModal();
		});
	});

	modal.querySelectorAll('[data-feedback-close]').forEach((el) => {
		el.addEventListener('click', closeModal);
	});

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		submitBtn.disabled = true;
		submitBtn.textContent = t.sending;
		status.textContent = '';
		status.classList.remove('is-error', 'is-success');

		try {
			const res = await fetch('/api/contact.php', {
				method: 'POST',
				body: new FormData(form),
			});
			const data = await res.json().catch(() => null);
			if (res.ok && data && data.ok) {
				status.textContent = t.success;
				status.classList.add('is-success');
				submitBtn.disabled = true;
				setTimeout(closeModal, 1800);
			} else {
				throw new Error('send_failed');
			}
		} catch (err) {
			status.textContent = t.error;
			status.classList.add('is-error');
			submitBtn.disabled = false;
			submitBtn.textContent = t.submit;
		}
	});
</script>

<style>
	.feedback-modal[hidden] {
		display: none;
	}

	.feedback-modal {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: clamp(1rem, 5vw, 2rem);
	}

	.feedback-modal__backdrop {
		position: absolute;
		inset: 0;
		background: color-mix(in srgb, var(--ink) 55%, transparent);
	}

	.feedback-modal__panel {
		position: relative;
		width: 100%;
		max-width: 28rem;
		max-height: 90vh;
		overflow-y: auto;
		background: var(--paper);
		border-radius: 1rem;
		padding: clamp(1.5rem, 4vw, 2rem);
		box-shadow: 0 1.5rem 4rem color-mix(in srgb, var(--ink) 35%, transparent);
	}

	.feedback-modal__close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 44px;
		min-height: 44px;
		background: none;
		border: 0;
		color: var(--ink);
		font-size: 1.5rem;
		line-height: 1;
		cursor: pointer;
		border-radius: 0.5rem;
	}

	.feedback-modal__close:hover {
		background: var(--surface);
	}

	.feedback-modal__title {
		margin: 0 0 1.25rem;
		font-size: 1.4rem;
		padding-right: 2rem;
	}

	.feedback-modal__form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.feedback-modal__field {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		font-size: 0.9rem;
	}

	.feedback-modal__field input,
	.feedback-modal__field textarea {
		font: inherit;
		color: var(--ink);
		background: var(--surface);
		border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent);
		border-radius: 0.5rem;
		padding: 0.6rem 0.75rem;
		resize: vertical;
	}

	.feedback-modal__field input:focus,
	.feedback-modal__field textarea:focus {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}

	.feedback-modal__honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.feedback-modal__submit {
		align-self: flex-start;
		margin-top: 0.25rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		padding: 0.7rem 1.5rem;
		border: 0;
		border-radius: 999px;
		background: var(--accent);
		color: var(--paper);
		font-weight: 600;
		font-size: 1rem;
		cursor: pointer;
	}

	.feedback-modal__submit:disabled {
		opacity: 0.7;
		cursor: default;
	}

	.feedback-modal__status {
		margin: 0;
		font-size: 0.9rem;
		min-height: 1.2em;
	}

	.feedback-modal__status.is-success {
		color: #1a7a3a;
	}

	.feedback-modal__status.is-error {
		color: var(--accent);
	}
</style>

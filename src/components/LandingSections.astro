---
import Card from './Card.astro';
import HowToIcon from './HowToIcon.astro';
import IconCorkscrew from './icons/IconCorkscrew.astro';
import { ui, defaultLang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang];
---

<section class="hero">
	<h1 class="hero__title">
		<span class="hero__title-line">{t.hero.title[0]}</span>
		<span class="hero__divider" aria-hidden="true"><IconCorkscrew /></span>
		<span class="hero__title-line">{t.hero.title[1]}</span>
	</h1>
	<p class="hero__subtitle">{t.hero.subtitle}</p>
	<p class="tagline">{t.hero.tagline}</p>
	<a class="button" href="#download">{t.hero.cta}</a>
</section>

<section class="section">
	<h2 class="section__heading">{t.forYou.heading}</h2>
	<div class="grid">
		{t.forYou.items.map((item) => <Card icon={item.icon} text={item.text} />)}
	</div>
</section>

<section class="section">
	<h2 class="section__heading">{t.choosing.heading}</h2>
	<div class="grid">
		{t.choosing.items.map((item) => <Card icon={item.icon} text={item.text} />)}
	</div>
</section>

<section class="section">
	<h2 class="section__heading">{t.learning.heading}</h2>
	<p class="section__text">{t.learning.text}</p>
</section>

<section class="section section--features">
	<Card icon={t.selfGuided.icon} text={t.selfGuided.text} variant="row" />
	<Card icon={t.openStructure.icon} text={t.openStructure.text} variant="row" />
</section>

<section class="closing" id="download">
	<a class="button button--large" href="#download">{t.closing.cta}</a>
</section>

<section class="section section--howto">
	<h2 class="section__heading">{t.howTo.heading}</h2>
	<div class="howto__terms">
		{t.howTo.terms.map((pair) => (
			<p class="howto__term-row">
				<span>{pair.vivino}</span>
				<span class="howto__arrow">
					<span class="howto__arrow-glyph" aria-hidden="true">→</span>{t.howTo.correspondsLabel}
				</span>
				<span>{pair.cavinum}</span>
			</p>
		))}
	</div>

	<div class="howto__group">
		<h3 class="howto__group-heading">{t.howTo.start.heading}</h3>
		<div class="howto__icons">
			{t.howTo.start.items.map((item) => (
				<div class="howto__item">
					<span class="howto__icon"><HowToIcon icon={item.icon} /></span>
					<span class="howto__label">{item.text}</span>
				</div>
			))}
		</div>
	</div>

	<div class="howto__group">
		<h3 class="howto__group-heading">{t.howTo.capabilities.heading}</h3>
		<div class="howto__icons">
			{t.howTo.capabilities.items.map((item) => (
				<div class="howto__item">
					<span class="howto__icon"><HowToIcon icon={item.icon} /></span>
					<span class="howto__label">{item.text}</span>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.tagline {
		margin: 0;
		text-align: center;
		font-size: clamp(1.15rem, 2.6vw, 1.6rem);
		font-weight: 600;
		letter-spacing: 0.01em;
		color: var(--accent);
		max-width: 34rem;
	}

	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-2);
		max-width: 48rem;
		margin-inline: auto;
		padding-block: var(--space-4) var(--space-2);
		padding-inline: clamp(1rem, 5vw, 3rem);
	}

	.hero__title {
		font-size: clamp(1.25rem, 5vw, 3rem);
		line-height: 1.15;
		margin: 0;
	}

	.hero__title-line {
		display: block;
	}

	.hero__divider {
		--hero-divider-gap: var(--space-1);
		display: block;
		width: clamp(1.5rem, 3.5vw, 2.25rem);
		margin-block: calc(var(--hero-divider-gap) * 1.15) calc(var(--hero-divider-gap) * 0.85);
		margin-inline: auto;
		color: var(--accent);
	}

	.hero__divider :global(svg) {
		display: block;
		width: 100%;
		height: auto;
		transform: rotate(-90deg);
	}

	.hero__subtitle {
		font-size: clamp(1rem, 2.2vw, 1.25rem);
		color: color-mix(in srgb, var(--ink) 75%, transparent);
		margin: 0;
		max-width: 38rem;
	}

	.section {
		width: 100%;
		max-width: var(--max-width);
		margin-inline: auto;
		padding-inline: clamp(1rem, 5vw, 3rem);
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
	}

	.section__heading {
		font-size: clamp(1.4rem, 3.2vw, 2rem);
		margin: 0;
		text-align: center;
	}

	.section__text {
		font-size: clamp(1rem, 2vw, 1.15rem);
		max-width: 42rem;
		margin-inline: auto;
		text-align: center;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: var(--space-2);
	}

	.section--features {
		gap: var(--space-2);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		min-width: 44px;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--paper);
		text-decoration: none;
		font-weight: 600;
		font-size: clamp(0.95rem, 1.8vw, 1.1rem);
	}

	.button--large {
		padding: 1rem 2.25rem;
		font-size: clamp(1rem, 2vw, 1.2rem);
	}

	.closing {
		display: flex;
		justify-content: center;
		padding-inline: clamp(1rem, 5vw, 3rem);
	}

	.section--howto {
		gap: var(--space-2);
	}

	.howto__terms {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		margin: 0;
	}

	.howto__term-row {
		margin: 0;
		text-align: center;
		font-size: clamp(0.9rem, 1.6vw, 1rem);
		color: color-mix(in srgb, var(--ink) 75%, transparent);
	}

	.howto__arrow {
		margin-inline: 0.4em;
	}

	.howto__arrow-glyph {
		color: var(--accent);
		margin-inline-end: 0.3em;
	}

	.howto__group {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-2);
	}

	.howto__group-heading {
		margin: 0;
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		text-align: center;
	}

	.howto__icons {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: var(--space-4);
		max-width: 44rem;
	}

	.howto__item {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: var(--space-1);
		width: 7rem;
	}

	.howto__icon {
		display: inline-flex;
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: clamp(2.25rem, 5vw, 3rem);
		height: clamp(2.25rem, 5vw, 3rem);
		border-radius: 50%;
		background: var(--accent);
		color: var(--paper);
		font-size: clamp(1.1rem, 2.5vw, 1.5rem);
	}

	.howto__icon :global(svg) {
		stroke-width: 2.25;
	}

	.howto__label {
		font-size: clamp(0.85rem, 1.6vw, 0.95rem);
		line-height: 1.35;
	}
</style>

---
import Card from './Card.astro';
import { ui, defaultLang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang];
---

<section class="hero">
	<h1 class="hero__title">
		<span class="hero__title-line">{t.hero.title[0]}</span>
		<span class="hero__divider" aria-hidden="true"></span>
		<span class="hero__title-line">{t.hero.title[1]}</span>
	</h1>
	<p class="hero__subtitle">{t.hero.subtitle}</p>
	<a class="button" href="#download">{t.hero.cta}</a>
</section>

<section class="section">
	<h2 class="section__heading">{t.forYou.heading}</h2>
	<div class="grid">
		{t.forYou.items.map((item) => <Card icon={item.icon} text={item.text} />)}
	</div>
</section>

<section class="section">
	<h2 class="section__heading">{t.choosing.heading}</h2>
	<div class="grid">
		{t.choosing.items.map((item) => <Card icon={item.icon} text={item.text} />)}
	</div>
</section>

<section class="section">
	<h2 class="section__heading">{t.learning.heading}</h2>
	<p class="section__text">{t.learning.text}</p>
</section>

<section class="section section--features">
	<Card icon={t.selfGuided.icon} text={t.selfGuided.text} variant="row" />
	<Card icon={t.openStructure.icon} text={t.openStructure.text} variant="row" />
</section>

<section class="closing" id="download">
	<a class="button button--large" href="#download">{t.closing.cta}</a>
</section>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: clamp(0.875rem, 2.5vw, 1.25rem);
		max-width: 48rem;
		margin-inline: auto;
		padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 3rem);
		min-height: clamp(16rem, 55svh, 28rem);
		justify-content: center;
	}

	.hero__title {
		font-size: clamp(1.25rem, 5vw, 3rem);
		line-height: 1.15;
		margin: 0;
	}

	.hero__title-line {
		display: block;
	}

	.hero__divider {
		display: block;
		width: clamp(2.5rem, 6vw, 5rem);
		height: clamp(2px, 0.3vw, 3px);
		margin: clamp(0.6rem, 1.5vw, 1rem) auto;
		background: var(--accent);
	}

	.hero__subtitle {
		font-size: clamp(1rem, 2.2vw, 1.25rem);
		color: color-mix(in srgb, var(--ink) 75%, transparent);
		margin: 0;
		max-width: 38rem;
	}

	.section {
		width: 100%;
		max-width: var(--max-width);
		margin-inline: auto;
		padding-inline: clamp(1rem, 5vw, 3rem);
		display: flex;
		flex-direction: column;
		gap: clamp(1.1rem, 3vw, 1.8rem);
	}

	.section__heading {
		font-size: clamp(1.4rem, 3.2vw, 2rem);
		margin: 0;
		text-align: center;
	}

	.section__text {
		font-size: clamp(1rem, 2vw, 1.15rem);
		max-width: 42rem;
		margin-inline: auto;
		text-align: center;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		gap: clamp(0.875rem, 2vw, 1.25rem);
	}

	.section--features {
		gap: clamp(0.875rem, 2vw, 1.25rem);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		min-width: 44px;
		padding: 0.85rem 1.75rem;
		border-radius: 999px;
		background: var(--accent);
		color: var(--paper);
		text-decoration: none;
		font-weight: 600;
		font-size: clamp(0.95rem, 1.8vw, 1.1rem);
	}

	.button--large {
		padding: 1rem 2.25rem;
		font-size: clamp(1rem, 2vw, 1.2rem);
	}

	.closing {
		display: flex;
		justify-content: center;
		padding-inline: clamp(1rem, 5vw, 3rem);
	}
</style>

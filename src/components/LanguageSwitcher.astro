---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages } from '../i18n/ui';
import IconWineGlassHoriz from './icons/IconWineGlassHoriz.astro';

const currentLocale = Astro.currentLocale ?? 'ru';
const currentPath = Astro.url.pathname.includes('privacy') ? '/privacy' : '/';
---

<nav class="lang-switch" aria-label="Language switcher">
	{
		Object.entries(languages).map(([lang, label], i) => (
			<a
				class="lang-switch__link"
				href={getRelativeLocaleUrl(lang, currentPath)}
				aria-current={lang === currentLocale ? 'page' : undefined}
				aria-label={label}
				data-lang={lang}
			>
				<IconWineGlassHoriz class="lang-switch__glass" code={lang.toUpperCase()} flip={i === 1} />
			</a>
		))
	}
</nav>

<script>
	// Явный выбор языка перевешивает Accept-Language-редирект в .htaccess
	// (правило 4a/4b) — держится год, пока пользователь не переключит сам.
	document.querySelectorAll<HTMLAnchorElement>('.lang-switch__link[data-lang]').forEach((link) => {
		link.addEventListener('click', () => {
			const lang = link.dataset.lang;
			if (!lang) return;
			const maxAge = 60 * 60 * 24 * 365;
			document.cookie = `cavinum_lang=${lang}; path=/; max-age=${maxAge}; SameSite=Lax`;
		});
	});
</script>

<style>
	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.1625rem;
	}

	.lang-switch__link {
		position: relative;
		display: inline-flex;
		align-items: center;
		text-decoration: none;
	}

	.lang-switch__link::before {
		content: '';
		position: absolute;
		top: 50%;
		left: 50%;
		width: 44px;
		height: 44px;
		transform: translate(-50%, -50%);
	}

	.lang-switch__link :global(.lang-switch__glass) {
		display: block;
		width: 3.25rem;
		height: auto;
	}

	.lang-switch__link :global(.lang-switch__wine) {
		fill-opacity: 0.16;
		transition: fill-opacity 0.15s;
	}

	.lang-switch__link:hover :global(.lang-switch__wine) {
		fill-opacity: 0.55;
	}

	.lang-switch__link[aria-current='page'] :global(.lang-switch__wine) {
		fill-opacity: 1;
	}

	.lang-switch__link :global(.lang-switch__code--dark) {
		fill: var(--accent);
		opacity: 1;
		transition: opacity 0.15s;
	}

	.lang-switch__link :global(.lang-switch__code--light) {
		fill: #fdf1e4;
		opacity: 0;
		transition: opacity 0.15s;
	}

	.lang-switch__link[aria-current='page'] :global(.lang-switch__code--dark) {
		opacity: 0;
	}

	.lang-switch__link[aria-current='page'] :global(.lang-switch__code--light) {
		opacity: 1;
	}
</style>

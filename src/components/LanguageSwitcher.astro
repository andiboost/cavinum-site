---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages } from '../i18n/ui';

const currentLocale = Astro.currentLocale ?? 'ru';
const currentPath = Astro.url.pathname.includes('privacy') ? '/privacy' : '/';
---

<nav class="lang-switch" aria-label="Language switcher">
	{
		Object.entries(languages).map(([lang, label]) => (
			<a
				class="lang-switch__link"
				href={getRelativeLocaleUrl(lang, currentPath)}
				aria-current={lang === currentLocale ? 'page' : undefined}
				aria-label={label}
			>
				{lang.toUpperCase()}
			</a>
		))
	}
</nav>

<style>
	.lang-switch {
		display: flex;
		background: var(--accent);
		border-radius: 0.375rem;
		overflow: hidden;
	}

	.lang-switch__link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		min-width: 44px;
		padding-inline: 0.375rem;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: rgb(255 255 255 / 70%);
		text-decoration: none;
		transition: background-color 0.15s, color 0.15s;
	}

	.lang-switch__link:hover {
		background: #5e1530;
	}

	.lang-switch__link[aria-current='page'] {
		background: #fff;
		color: var(--accent);
	}

	.lang-switch__link[aria-current='page']:hover {
		background: #fff;
	}
</style>

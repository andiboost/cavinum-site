---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages } from '../i18n/ui';

const currentLocale = Astro.currentLocale ?? 'ru';
const currentPath = Astro.url.pathname.includes('privacy') ? '/privacy' : '/';
---

<nav aria-label="Language switcher">
	{
		Object.entries(languages).map(([lang, label]) => (
			<a
				href={getRelativeLocaleUrl(lang, currentPath)}
				aria-current={lang === currentLocale ? 'page' : undefined}
			>
				{label}
			</a>
		))
	}
</nav>

<style>
	nav {
		display: flex;
		gap: 0.5rem;
	}
	a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 44px;
		min-width: 44px;
		padding: 0.5rem 0.75rem;
		border-radius: 0.5rem;
		color: inherit;
		text-decoration: none;
	}
	a[aria-current='page'] {
		font-weight: bold;
		text-decoration: underline;
	}
</style>

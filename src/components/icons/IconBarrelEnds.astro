---
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width="1em"
	height="1em"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
>
	<circle cx="8" cy="17" r="4" />
	<circle cx="8" cy="17" r="1.9" />
	<circle cx="16" cy="17" r="4" />
	<circle cx="16" cy="17" r="1.9" />
	<circle cx="12" cy="9.7" r="4" />
	<circle cx="12" cy="9.7" r="1.9" />
</svg>

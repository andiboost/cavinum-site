	width="1em"
	height="1em"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
>
	<rect x="4" y="4" width="16" height="14" rx="1" />
	<path d="M4 9.33h16" />
	<path d="M4 14.67h16" />
	<path d="M7 18v3" />
	<path d="M17 18v3" />
	<circle cx="7.5" cy="6.6" r="1" fill="currentColor" stroke="none" />
	<circle cx="12" cy="6.6" r="1" fill="currentColor" stroke="none" />
	<circle cx="16.5" cy="6.6" r="1" fill="currentColor" stroke="none" />
</svg>

---
import IconFlute from './IconFlute.astro';

interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['icon-glasses-pair', className]}>
	<span class="icon-glasses-pair__back"><IconFlute /></span>
	<span class="icon-glasses-pair__front"><IconFlute /></span>
</span>

<style>
	.icon-glasses-pair {
		position: relative;
		display: inline-grid;
		place-items: center;
		width: 1em;
		height: 1em;
	}
	.icon-glasses-pair__back,
	.icon-glasses-pair__front {
		position: absolute;
		display: block;
		bottom: 0;
		width: 0.85em;
		height: 0.85em;
	}
	.icon-glasses-pair__back :global(svg),
	.icon-glasses-pair__front :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}
	.icon-glasses-pair__back {
		left: -0.2em;
		transform: rotate(18deg);
		transform-origin: bottom center;
	}
	.icon-glasses-pair__front {
		right: -0.2em;
		transform: rotate(-18deg);
		transform-origin: bottom center;
	}
</style>

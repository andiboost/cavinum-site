---
interface Props {
	code: string;
	flip?: boolean;
	class?: string;
}
const { code, flip = false, class: className } = Astro.props;

const bowlPoints = flip ? '38,2 18,11 18,13 38,22' : '2,2 22,11 22,13 2,22';
const stemX = flip ? 2 : 22;
const footX = flip ? 0 : 38;
const textX = flip ? 31 : 9;
---

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 24" class={className} aria-hidden="true">
	<polygon
		class="lang-switch__wine"
		points={bowlPoints}
		fill="#7b1e3a"
		stroke="var(--accent)"
		stroke-width="1.5"
		stroke-linejoin="round"
	/>
	<rect x={stemX} y="11" width="16" height="2" fill="var(--accent)" />
	<rect x={footX} y="6" width="2" height="12" fill="var(--accent)" />
	<text
		class="lang-switch__code lang-switch__code--dark"
		x={textX}
		y="12.5"
		text-anchor="middle"
		dominant-baseline="central"
		font-size="7"
		font-weight="700">{code}</text
	>
	<text
		class="lang-switch__code lang-switch__code--light"
		x={textX}
		y="12.5"
		text-anchor="middle"
		dominant-baseline="central"
		font-size="7"
		font-weight="700">{code}</text
	>
</svg>

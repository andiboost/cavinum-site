---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import Card from '../components/Card.astro';
import IconBottle from '../components/icons/IconBottle.astro';
import IconGlassMark from '../components/icons/IconGlassMark.astro';
import { ui, defaultLang } from '../i18n/ui';

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang];
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={t.meta.description} />
		<title>{t.title}</title>
	</head>
	<body>
		<header class="site-header">
			<span class="site-header__brand">
				<span class="sr-only">{t.title}</span>
				<span class="site-header__word" aria-hidden="true"
					>Ca<span class="site-header__v"><IconGlassMark /></span>inum</span
				>
			</span>
			<LanguageSwitcher />
		</header>

		<main>
			<section class="hero">
				<div class="hero__glyph" aria-hidden="true">
					<IconBottle />
				</div>
				<h1 class="hero__title">{t.hero.title}</h1>
				<p class="hero__subtitle">{t.hero.subtitle}</p>
				<a class="button" href="#download">{t.hero.cta}</a>
			</section>

			<section class="section">
				<h2 class="section__heading">{t.forYou.heading}</h2>
				<div class="grid">
					{t.forYou.items.map((item) => <Card icon={item.icon} text={item.text} />)}
				</div>
			</section>

			<section class="section">
				<h2 class="section__heading">{t.choosing.heading}</h2>
				<div class="grid">
					{t.choosing.items.map((item) => <Card icon={item.icon} text={item.text} />)}
				</div>
			</section>

			<section class="section">
				<h2 class="section__heading">{t.learning.heading}</h2>
				<p class="section__text">{t.learning.text}</p>
			</section>

			<section class="section section--features">
				<Card icon={t.selfGuided.icon} text={t.selfGuided.text} variant="row" />
				<Card icon={t.openStructure.icon} text={t.openStructure.text} variant="row" />
			</section>

			<section class="closing" id="download">
				<a class="button button--large" href="#download">{t.closing.cta}</a>
			</section>
		</main>

		<style>
			:root {
				--ink: #2a1f1a;
				--paper: #fdf6ec;
				--surface: #f8e6d4;
				--accent: #7b1e3a;
				--max-width: 68rem;
			}

			* {
				box-sizing: border-box;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			html {
				color-scheme: light;
			}

			body {
				margin: 0;
				background: var(--paper);
				color: var(--ink);
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				line-height: 1.5;
			}

			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: clamp(0.75rem, 2.5vw, 1.25rem) clamp(1rem, 5vw, 3rem);
				max-width: var(--max-width);
				margin-inline: auto;
			}

			.site-header__brand {
				display: inline-block;
				font-weight: 800;
				font-size: clamp(1.4rem, 3vw, 1.9rem);
				letter-spacing: -0.01em;
			}

			.site-header__word {
				display: inline-block;
			}

			.site-header__v {
				display: inline-block;
				height: 0.72em;
				color: var(--accent);
				vertical-align: -0.02em;
				margin-inline: 0.02em;
			}

			.site-header__v :global(svg) {
				display: block;
				height: 100%;
				width: auto;
			}

			main {
				display: flex;
				flex-direction: column;
				gap: clamp(2.5rem, 6vw, 4.5rem);
				padding-block-end: clamp(2.5rem, 6vw, 4.5rem);
			}

			.hero {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				gap: clamp(0.875rem, 2.5vw, 1.25rem);
				max-width: 48rem;
				margin-inline: auto;
				padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 5vw, 3rem);
				min-height: clamp(16rem, 55svh, 28rem);
				justify-content: center;
			}

			.hero__glyph {
				font-size: clamp(4rem, 12vw, 6rem);
				width: 1em;
				height: 1em;
				color: var(--accent);
				line-height: 0;
			}

			.hero__title {
				font-size: clamp(1.75rem, 5vw, 3rem);
				line-height: 1.15;
				margin: 0;
			}

			.hero__subtitle {
				font-size: clamp(1rem, 2.2vw, 1.25rem);
				color: color-mix(in srgb, var(--ink) 75%, transparent);
				margin: 0;
				max-width: 38rem;
			}

			.section {
				width: 100%;
				max-width: var(--max-width);
				margin-inline: auto;
				padding-inline: clamp(1rem, 5vw, 3rem);
				display: flex;
				flex-direction: column;
				gap: clamp(1.1rem, 3vw, 1.8rem);
			}

			.section__heading {
				font-size: clamp(1.4rem, 3.2vw, 2rem);
				margin: 0;
				text-align: center;
			}

			.section__text {
				font-size: clamp(1rem, 2vw, 1.15rem);
				max-width: 42rem;
				margin-inline: auto;
				text-align: center;
			}

			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
				gap: clamp(0.875rem, 2vw, 1.25rem);
			}

			.section--features {
				gap: clamp(0.875rem, 2vw, 1.25rem);
			}

			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 44px;
				min-width: 44px;
				padding: 0.85rem 1.75rem;
				border-radius: 999px;
				background: var(--accent);
				color: var(--paper);
				text-decoration: none;
				font-weight: 600;
				font-size: clamp(0.95rem, 1.8vw, 1.1rem);
			}

			.button--large {
				padding: 1rem 2.25rem;
				font-size: clamp(1rem, 2vw, 1.2rem);
			}

			.closing {
				display: flex;
				justify-content: center;
				padding-inline: clamp(1rem, 5vw, 3rem);
			}
		</style>
	</body>
</html>

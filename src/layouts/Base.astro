---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import FeedbackModal from '../components/FeedbackModal.astro';
import AgeGate from '../components/AgeGate.astro';
import IconGlassMark from '../components/icons/IconGlassMark.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, defaultLang, languages } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
}

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang];
const { title = t.title, description = t.meta.description } = Astro.props;
const privacyHref = getRelativeLocaleUrl(lang, '/privacy');
const homeHref = getRelativeLocaleUrl(lang, '/');

// Путь без языкового префикса и с конечным слэшем (кроме корня), например
// '/' или '/privacy/' — каноническая форма URL на этом сервере (см. факт:
// Apache 301-редиректит /privacy -> /privacy/). Параметрический вывод из
// текущего маршрута — новые страницы вроде /install подхватятся сами.
const currentPrefix = lang === defaultLang ? '' : `/${lang}`;
const rawPath = Astro.url.pathname.startsWith(currentPrefix)
	? Astro.url.pathname.slice(currentPrefix.length) || '/'
	: Astro.url.pathname;
const routePath = rawPath === '/' ? '/' : `${rawPath.replace(/\/$/, '')}/`;

const localeCodes = Object.keys(languages) as (keyof typeof languages)[];
const toAbsolute = (path: string) => new URL(path, Astro.site).href;
const canonicalURL = toAbsolute(getRelativeLocaleUrl(lang, routePath));
const hreflangLinks = localeCodes.map((code) => ({
	code,
	href: toAbsolute(getRelativeLocaleUrl(code, routePath)),
}));
// x-default — версия для аудитории вне ru/en (не совпадает ни с одним явным
// hreflang). Здесь указан en как более широко понятный вариант из двух
// существующих; ru — дефолтная локаль сайта (корень без префикса) — тоже
// разумный кандидат. Решение окончательное — за Андреем.
const xDefaultHref = toAbsolute(getRelativeLocaleUrl('en', routePath));
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			// Блокирующий, до отрисовки — иначе возрастной попап на / успеет
			// мигнуть русским текстом перед переходом на /en/.
			// Серверный редирект по Accept-Language убрали (заголовок не
			// доходил через nginx->Apache, см. историю .htaccess) — язык
			// теперь определяется здесь же, в браузере.
			(function () {
				try {
					var path = location.pathname;
					if (path === '/en' || path.indexOf('/en/') === 0) return;

					var stored;
					try {
						stored = localStorage.getItem('cavinum-lang');
					} catch (e) {}
					// Явный выбор работает в обе стороны: en уводит на /en/ даже
					// если до этого путь был русским, ru — всегда остаётся на
					// месте. Только при отсутствии явного выбора смотрим язык
					// браузера.
					if (stored === 'en') {
						location.replace('/en' + path + location.search + location.hash);
						return;
					}
					if (stored === 'ru') return;

					var langs =
						navigator.languages && navigator.languages.length
							? navigator.languages
							: [navigator.language || ''];
					for (var i = 0; i < langs.length; i++) {
						if (/^ru(-|$)/i.test(langs[i])) return;
					}

					location.replace('/en' + path + location.search + location.hash);
				} catch (e) {}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="google-site-verification" content="tgvbdDx95LmELM7HT4DHmcUH7xNQAFZmAE1YMIwBob8" />
		<link rel="canonical" href={canonicalURL} />
		{hreflangLinks.map((alt) => (
			<link rel="alternate" hreflang={alt.code} href={alt.href} />
		))}
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<a class="site-header__brand" href={homeHref}>
				<span class="sr-only">{t.title}</span>
				<span class="site-header__word" aria-hidden="true"
					>Ca<span class="site-header__v"><IconGlassMark /></span>inum</span
				>
			</a>
			<LanguageSwitcher />
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<a href={privacyHref}>{t.footer.privacy}</a>
			<button type="button" class="site-footer__button" data-open-feedback
				>{t.footer.feedback}</button
			>
		</footer>

		<FeedbackModal />
		<AgeGate />

		<style>
			:root {
				--ink: #2a1f1a;
				--paper: #fdf6ec;
				--surface: #f8e6d4;
				--accent: #7b1e3a;
				--max-width: 68rem;

				--space-1: clamp(0.5rem, 1.4vw, 0.75rem);
				--space-2: clamp(0.75rem, 1.8vw, 1rem);
				--space-3: clamp(1rem, 2.4vw, 1.5rem);
				--space-4: clamp(1.5rem, 3.2vw, 2rem);
				--space-5: clamp(1.75rem, 4vw, 3rem);
			}

			:global(*) {
				box-sizing: border-box;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			html {
				color-scheme: light;
			}

			body {
				margin: 0;
				background: var(--paper);
				color: var(--ink);
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				line-height: 1.5;
			}

			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: var(--space-2) clamp(1rem, 5vw, 3rem);
				max-width: var(--max-width);
				margin-inline: auto;
			}

			.site-header__brand {
				display: inline-block;
				font-weight: 800;
				font-size: clamp(1.4rem, 3vw, 1.9rem);
				letter-spacing: -0.01em;
				color: inherit;
				text-decoration: none;
				border-radius: 0.25rem;
				transition: opacity 0.15s;
			}

			.site-header__brand:hover {
				opacity: 0.8;
			}

			.site-header__brand:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}

			.site-header__word {
				display: inline-block;
			}

			.site-header__v {
				display: inline-block;
				height: 1.312em;
				color: var(--accent);
				vertical-align: -0.592em;
				margin-inline: 0.02em;
			}

			.site-header__v :global(svg) {
				display: block;
				height: 100%;
				width: auto;
			}

			main {
				display: flex;
				flex-direction: column;
				gap: var(--space-5);
				padding-block-end: var(--space-5);
			}

			.site-footer {
				display: flex;
				justify-content: center;
				gap: 1.5rem;
				padding: var(--space-3) clamp(1rem, 5vw, 3rem);
				max-width: var(--max-width);
				margin-inline: auto;
			}

			.site-footer a,
			.site-footer__button {
				color: color-mix(in srgb, var(--ink) 65%, transparent);
				font-size: 0.9rem;
				text-decoration: underline;
			}

			.site-footer__button {
				background: none;
				border: 0;
				padding: 0;
				font-family: inherit;
				cursor: pointer;
			}
		</style>
	</body>
</html>

---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import FeedbackModal from '../components/FeedbackModal.astro';
import IconGlassMark from '../components/icons/IconGlassMark.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { ui, defaultLang } from '../i18n/ui';

interface Props {
	title?: string;
	description?: string;
}

const lang = (Astro.currentLocale ?? defaultLang) as keyof typeof ui;
const t = ui[lang];
const { title = t.title, description = t.meta.description } = Astro.props;
const privacyHref = getRelativeLocaleUrl(lang, '/privacy');
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<span class="site-header__brand">
				<span class="sr-only">{t.title}</span>
				<span class="site-header__word" aria-hidden="true"
					>Ca<span class="site-header__v"><IconGlassMark /></span>inum</span
				>
			</span>
			<LanguageSwitcher />
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<a href={privacyHref}>{t.footer.privacy}</a>
			<button type="button" class="site-footer__button" data-open-feedback
				>{t.footer.feedback}</button
			>
		</footer>

		<FeedbackModal />

		<style>
			:root {
				--ink: #2a1f1a;
				--paper: #fdf6ec;
				--surface: #f8e6d4;
				--accent: #7b1e3a;
				--max-width: 68rem;
			}

			:global(*) {
				box-sizing: border-box;
			}

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			html {
				color-scheme: light;
			}

			body {
				margin: 0;
				background: var(--paper);
				color: var(--ink);
				font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
				line-height: 1.5;
			}

			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: clamp(0.75rem, 2.5vw, 1.25rem) clamp(1rem, 5vw, 3rem);
				max-width: var(--max-width);
				margin-inline: auto;
			}

			.site-header__brand {
				display: inline-block;
				font-weight: 800;
				font-size: clamp(1.4rem, 3vw, 1.9rem);
				letter-spacing: -0.01em;
			}

			.site-header__word {
				display: inline-block;
			}

			.site-header__v {
				display: inline-block;
				height: 1.312em;
				color: var(--accent);
				vertical-align: -0.592em;
				margin-inline: 0.02em;
			}

			.site-header__v :global(svg) {
				display: block;
				height: 100%;
				width: auto;
			}

			main {
				display: flex;
				flex-direction: column;
				gap: clamp(2.5rem, 6vw, 4.5rem);
				padding-block-end: clamp(2.5rem, 6vw, 4.5rem);
			}

			.site-footer {
				display: flex;
				justify-content: center;
				gap: 1.5rem;
				padding: clamp(1.25rem, 3vw, 2rem) clamp(1rem, 5vw, 3rem);
				max-width: var(--max-width);
				margin-inline: auto;
			}

			.site-footer a,
			.site-footer__button {
				color: color-mix(in srgb, var(--ink) 65%, transparent);
				font-size: 0.9rem;
				text-decoration: underline;
			}

			.site-footer__button {
				background: none;
				border: 0;
				padding: 0;
				font-family: inherit;
				cursor: pointer;
			}
		</style>
	</body>
</html>
